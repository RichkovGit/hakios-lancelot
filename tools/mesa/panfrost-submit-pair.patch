--- a/include/drm-uapi/panfrost_drm.h
+++ b/include/drm-uapi/panfrost_drm.h
@@ -69,6 +69,20 @@
 
 	/** A combination of PANFROST_JD_REQ_* */
 	__u32 requirements;
+
+	/**
+	 * Redwood (not Linux's UAPI): the second chain of the same batch, sent in the same
+	 * call -- a batch's vertex and tiler chain and its fragment chain. Two calls into this
+	 * kernel are 30 to 35 us each and a frame of the window server's has 16 of them (run 29);
+	 * queued together, nothing of anybody else's can come between the tiler's polygon list
+	 * and the fragment job that reads it. 0: one chain, as before.
+	 */
+	__u64 jc2;
+
+	/** ... the requirements of the second. */
+	__u32 requirements2;
+
+	__u32 pad2;
 };
 
