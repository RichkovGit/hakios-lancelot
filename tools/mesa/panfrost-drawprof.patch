Redwood: what a draw costs the processor, in its parts, said every 6000 draws.

A frame of the window server makes 60 to 130 draws of four triangles each and spends 5 to
20 ms in them (run 21, boot-arg glprof=1: 48 us a draw, 11 of them the kernel's), while
the GPU is idle. Inside panfrost a draw costs 20 to 31 us, and two thirds of that is the
state it emits -- mostly the textures' descriptors, which a draw that binds its own texture
makes again each time (run 22). On when the program has PANPROF in its environment (the
window server gets it from boot-arg glenv=PANPROF=1, see userland/src/eagl.c).

--- a/src/gallium/drivers/panfrost/pan_cmdstream.c
+++ b/src/gallium/drivers/panfrost/pan_cmdstream.c
@@ -58,6 +58,86 @@
 #include "pan_texture.h"
 #include "pan_util.h"
 
+/*
+ * Redwood: what a draw costs the processor, in six parts, said every 6000 draws. A frame of the
+ * window server makes 60 to 130 draws of four triangles each and spends 5 to 20 ms in them (run 21,
+ * boot-arg glprof=1: 48 us a draw, and the kernel's part of it 11 us), while the GPU is idle: this
+ * says where in the driver the rest is. On when the program's environment has PANPROF (the
+ * window server gets it from boot-arg glenv=PANPROF=1, see userland/src/eagl.c).
+ */
+#include "util/os_time.h"
+#include <stdlib.h>
+#include <unistd.h>
+enum {
+   PROF_PREPARE,        /* prepare_draw: the batch for this framebuffer, its viewport */
+   PROF_VERTEX,         /* panfrost_draw_get_vertex_count: vertex and index buffers made ready */
+   PROF_STATE,          /* panfrost_update_state_3d, the shader states, clean_state_3d */
+   PROF_TEXDESC,        /* ... of that, the textures' descriptors made (a draw's own state, mostly) */
+   PROF_SAMPLER,        /* ... and the samplers' */
+   PROF_RSD,            /* ... and the fragment shader's renderer state descriptor */
+   PROF_CONST,          /* ... and the uniforms */
+   PROF_CLEAN,          /* ... and panfrost_clean_state_3d */
+   PROF_VARYING,        /* panfrost_emit_varying_descriptor */
+   PROF_LAUNCH,         /* JOBX(launch_draw): the descriptors and the job chain */
+   PROF_DRAW,           /* the whole of panfrost_draw_vbo */
+   PROF_AREAS
+};
+static uint64_t redwood_prof_ns[PROF_AREAS], redwood_prof_draws;
+static int redwood_prof = -1;
+static int
+redwood_prof_on(void)
+{
+   if (redwood_prof < 0)
+      redwood_prof = getenv("PANPROF") != NULL;
+   return redwood_prof;
+}
+
+/* the end of one part of a draw, in a function that began with `prof_began` */
+#define RPROF_END(area)                                                        \
+   do {                                                                        \
+      if (prof_began) {                                                        \
+         int64_t rprof_now = os_time_get_nano();                               \
+         redwood_prof_ns[area] += (uint64_t)(rprof_now - prof_began);          \
+         prof_began = rprof_now;                                               \
+      }                                                                        \
+   } while (0)
+
+/* "redwood draw: 6000 draws, 48 us a draw (prepare 1, vertex buffers 8, state 5, varying 1, launch 32)" */
+static void
+redwood_prof_say(void)
+{
+   extern uint64_t redwood_pan_submit_ns, redwood_pan_submits;
+   static uint64_t said_submit_ns, said_submits;
+   uint64_t draws = redwood_prof_draws ? redwood_prof_draws : 1;
+   char line[768];
+   int n;
+
+   n = snprintf(line, sizeof(line),
+      "redwood draw: %llu draws, %llu us a draw (prepare %llu, vertex buffers %llu, state %llu: textures %llu, "
+      "samplers %llu, renderer state %llu, uniforms %llu, clean %llu; varying %llu, launch %llu); "
+      "%llu batches submitted in them, %llu us a draw\n",
+      (unsigned long long)redwood_prof_draws,
+      (unsigned long long)(redwood_prof_ns[PROF_DRAW] / 1000 / draws),
+      (unsigned long long)(redwood_prof_ns[PROF_PREPARE] / 1000 / draws),
+      (unsigned long long)(redwood_prof_ns[PROF_VERTEX] / 1000 / draws),
+      (unsigned long long)(redwood_prof_ns[PROF_STATE] / 1000 / draws),
+      (unsigned long long)(redwood_prof_ns[PROF_TEXDESC] / 1000 / draws),
+      (unsigned long long)(redwood_prof_ns[PROF_SAMPLER] / 1000 / draws),
+      (unsigned long long)(redwood_prof_ns[PROF_RSD] / 1000 / draws),
+      (unsigned long long)(redwood_prof_ns[PROF_CONST] / 1000 / draws),
+      (unsigned long long)(redwood_prof_ns[PROF_CLEAN] / 1000 / draws),
+      (unsigned long long)(redwood_prof_ns[PROF_VARYING] / 1000 / draws),
+      (unsigned long long)(redwood_prof_ns[PROF_LAUNCH] / 1000 / draws),
+      (unsigned long long)(redwood_pan_submits - said_submits),
+      (unsigned long long)((redwood_pan_submit_ns - said_submit_ns) / 1000 / draws));
+   if (n > 0)
+      (void)!write(2, line, (size_t)n);
+   said_submit_ns = redwood_pan_submit_ns;
+   said_submits = redwood_pan_submits;
+   redwood_prof_draws = 0;
+   memset(redwood_prof_ns, 0, sizeof(redwood_prof_ns));
+}
+
