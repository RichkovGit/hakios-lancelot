# Diagnostic only: boot the Redmi 9 and open Settings with the layout used by rc.jobs.net29.
# Build with BT=1 GL=1 REST=1 WIFID=1 NILINJECT=Preferences CIINJECT=Preferences.
# Allow enough time for SpringBoard and confirm the panel from the local framebuffer capture.
/redwood/bin/net_test wait 22
/redwood/bin/net_test dhcp en0 waitaddr en0 10
/redwood/bin/net_test fbwait 60
/redwood/bin/net_test wait 16
/redwood/bin/rwtouch swipe 0.5 0.985 0.5 0.3 200
/redwood/bin/net_test wait 3
/redwood/bin/rwtouch tap 0.543 0.712
/redwood/bin/net_test wait 6
/redwood/bin/rwtouch tap 0.5 0.422
/redwood/bin/net_test wait 10
/redwood/bin/net_test procs Preferences
/redwood/bin/fbgrab -log btsettings 300 0.5
/redwood/bin/net_test end
